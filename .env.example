# Copy to .env and fill in. .env is gitignored — never commit it.
# On Railway, set these as Variables in the dashboard instead of shipping a .env.

# ntfy topic = your secret. Anyone who knows it can read your alerts. Keep it private.
# Publish anonymously; do NOT set an auth token, ntfy 401s on a stale one.
NTFY_TOPIC=nm-CHANGEME

# Dates to alert on (comma YYYY-MM-DD).
WATCH=2026-11-28,2026-11-29,2026-11-30

# Month probed for new releases. All-null apply_type means not yet on sale, so the
# flip to non-null is the "a new month just opened" signal.
HORIZON=2027-01

# Seconds between sweeps when looping.
INTERVAL=90

# Set to 1 for a single sweep then exit (launchd / cron). Unset = loop forever.
RUN_ONCE=
