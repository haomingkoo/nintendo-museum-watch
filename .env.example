# Copy to .env and fill in. .env is gitignored — never commit it.
# On Railway, set these as Variables in the dashboard instead of shipping a .env.

# ntfy topic = your secret. Anyone who knows it can read your alerts. Keep it private.
NTFY_TOPIC=pb-CHANGEME

# Dates to watch (comma DD/MM/YYYY) and the route code.
DATES=05/08/2026,06/08/2026,07/08/2026,08/08/2026
PRODUCT=BEL-LAK

# Seconds between scans.
INTERVAL=90

# Party size. The feed is qty-blind unless this is set, so it's required for an
# accurate "can N people actually book?" signal.
ADULTS=4

# Optional email alerts. ntfy.sh blocks anonymous email, so this needs a free
# ntfy.sh account token. Leave blank to use phone push only (recommended).
ALERT_EMAIL=
NTFY_TOKEN=
